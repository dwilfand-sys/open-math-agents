theorem OMA.solution : OMA.R_oeis_a085265_R2_H2_R1_H1_R1_H1_R1_H1_R1_H2_R1.H1 := by
  have hc := A085265Moderate.firstCost
  rw [A085265Moderate.costUpper, A085265Moderate.qSift_fold] at hc
  exact hc
