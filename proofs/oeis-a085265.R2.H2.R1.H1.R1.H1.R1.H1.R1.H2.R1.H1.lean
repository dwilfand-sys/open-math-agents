/-!
Packed quotient tables certify the first numerical endpoint bound. Each field is verified
against the defining recurrence. The complete 210-block for {2, 3, 5, 7} has 48 survivors.
Source: https://oeis.org/A085265
Credit: @dwilfand-sys
-/

open scoped BigOperators

namespace A085265Moderate

def qSift : List Nat → Nat → Int
  | [], y => (y : Int)
  | p :: ps, y =>
      if y = 0 then 0 else qSift ps y - qSift ps (y / p)

def wheel : List ℕ :=
  [101,97,89,83,79,73,71,67,61,59,53,47,43,41,37,31,29,23,19,17,13,11,7,5,3,2]

def primeDeltas (j : ℕ) : ℕ :=
  ∑ p ∈ (Finset.range 1415).filter (fun p => 2 < p ∧ p.Prime), 2*j/(p^2)

def costUpper (j : ℕ) : ℤ := qSift wheel (2*j+1) + 24 + primeDeltas j

private def suffixValue : List ℕ → ℕ → ℤ
  | [], y => (y : ℤ)
  | row :: _, y => (((row >>> (9*y)) &&& 511 : ℕ) : ℤ)

private def cacheValid : List ℕ → List ℕ → Bool
  | [], [] => true
  | p :: ps, row :: tail =>
    ((List.range 257).all fun y => decide
      (suffixValue (row :: tail) y =
        if y = 0 then (0 : ℤ) else suffixValue tail y - suffixValue tail (y / p))) &&
      cacheValid ps tail
  | _, _ => false

private def cachedQSift : List ℕ → List ℕ → ℕ → ℤ
  | [], _, y => (y : ℤ)
  | p :: ps, [], y => qSift (p :: ps) y
  | p :: ps, row :: tail, y =>
    if y ≤ 256 then suffixValue (row :: tail) y
    else cachedQSift ps tail y - cachedQSift ps tail (y / p)

private theorem cachedQSift_correct (ps : List ℕ) :
    ∀ ts : List ℕ, cacheValid ps ts = true →
      (∀ y : ℕ, y ≤ 256 → suffixValue ts y = qSift ps y) ∧
        (∀ y : ℕ, cachedQSift ps ts y = qSift ps y) := by
  induction ps with
  | nil =>
    intro ts
    cases ts with
    | nil => intro _; exact ⟨fun _ _ => rfl, fun _ => rfl⟩
    | cons _ _ => simp [cacheValid]
  | cons p ps ih =>
    intro ts
    cases ts with
    | nil => simp [cacheValid]
    | cons row tail =>
      intro hv
      have hparts : (∀ y : ℕ, y < 257 → suffixValue (row :: tail) y =
          if y = 0 then (0 : ℤ) else suffixValue tail y - suffixValue tail (y / p)) ∧
          cacheValid ps tail = true := by
        simpa [cacheValid] using hv
      obtain ⟨hsmall, heval⟩ := ih tail hparts.2
      have low (y : ℕ) (hy : y ≤ 256) :
          suffixValue (row :: tail) y = qSift (p :: ps) y := by
        rw [hparts.1 y (by omega)]
        by_cases hz : y = 0
        · simp [qSift, hz]
        · simp only [qSift, if_neg hz, hsmall y hy,
            hsmall (y/p) ((Nat.div_le_self y p).trans hy)]
      refine ⟨low, ?_⟩
      intro y
      by_cases hy : y ≤ 256
      · simpa only [cachedQSift, if_pos hy] using low y hy
      · have hz : y ≠ 0 := by omega
        simp only [cachedQSift, if_neg hy, qSift, if_neg hz, heval]

/- Optional local extension. Include in A085265Moderate after cachedQSift_correct
   and before costUpper_cached. The four smallest primes have period 210. -/

private theorem qSift_zero' (ps : List ℕ) : qSift ps 0 = 0 := by
  cases ps <;> simp [qSift]

private theorem qSift_cons_plain (p : ℕ) (ps : List ℕ) (y : ℕ) :
    qSift (p :: ps) y = qSift ps y - qSift ps (y/p) := by
  by_cases hy : y = 0
  · simp [qSift, hy, qSift_zero']
  · simp [qSift, hy]

private theorem qSift_nil' (y : ℕ) : qSift [] y = (y : ℤ) := rfl

/-- Every complete 210-block has 48 integers prime to 2, 3, 5 and 7. -/
private theorem qSiftFourPeriod (a b : ℕ) :
    qSift [7,5,3,2] (210*a+b) = 48*(a : ℤ) + qSift [7,5,3,2] b := by
  have h2 : (210*a+b)/2 = 105*a+b/2 := by omega
  have h3 : (210*a+b)/3 = 70*a+b/3 := by omega
  have h5 : (210*a+b)/5 = 42*a+b/5 := by omega
  have h6 : (210*a+b)/6 = 35*a+b/6 := by omega
  have h7 : (210*a+b)/7 = 30*a+b/7 := by omega
  have h10 : (210*a+b)/10 = 21*a+b/10 := by omega
  have h14 : (210*a+b)/14 = 15*a+b/14 := by omega
  have h15 : (210*a+b)/15 = 14*a+b/15 := by omega
  have h21 : (210*a+b)/21 = 10*a+b/21 := by omega
  have h30 : (210*a+b)/30 = 7*a+b/30 := by omega
  have h35 : (210*a+b)/35 = 6*a+b/35 := by omega
  have h42 : (210*a+b)/42 = 5*a+b/42 := by omega
  have h70 : (210*a+b)/70 = 3*a+b/70 := by omega
  have h105 : (210*a+b)/105 = 2*a+b/105 := by omega
  have h210 : (210*a+b)/210 = 1*a+b/210 := by omega
  simp only [qSift_cons_plain, qSift_nil', Nat.div_div_eq_div_mul]
  norm_num1
  simp only [h2, h3, h5, h6, h7, h10, h14, h15, h21, h30, h35, h42, h70, h105, h210, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat]
  ring

private def periodicQSift : List ℕ → List ℕ → ℕ → ℤ
  | [], _, y => (y : ℤ)
  | p :: ps, [], y => qSift (p :: ps) y
  | p :: ps, row :: tail, y =>
    if p = 7 ∧ ps = [5,3,2] then
      48*((y/210 : ℕ) : ℤ) + suffixValue (row :: tail) (y%210)
    else if y ≤ 256 then suffixValue (row :: tail) y
    else periodicQSift ps tail y - periodicQSift ps tail (y / p)

private theorem periodicQSift_correct (ps : List ℕ) :
    ∀ ts : List ℕ, cacheValid ps ts = true →
      ∀ y : ℕ, periodicQSift ps ts y = qSift ps y := by
  induction ps with
  | nil =>
    intro ts _ y
    rfl
  | cons p ps ih =>
    intro ts
    cases ts with
    | nil => simp [cacheValid]
    | cons row tail =>
      intro hv y
      have ht : cacheValid ps tail = true := (Bool.and_eq_true_iff.mp hv).2
      have hlow := (cachedQSift_correct (p :: ps) (row :: tail) hv).1
      by_cases hfour : p = 7 ∧ ps = [5,3,2]
      · simp only [periodicQSift, if_pos hfour]
        rw [hlow (y%210) (by omega)]
        rcases hfour with ⟨rfl,rfl⟩
        have hy : 210*(y/210)+y%210 = y := by omega
        simpa only [hy] using (qSiftFourPeriod (y/210) (y%210)).symm
      · by_cases hy : y ≤ 256
        · simpa only [periodicQSift, if_neg hfour, if_pos hy] using hlow y hy
        · simp only [periodicQSift, if_neg hfour, if_neg hy, qSift_cons_plain, ih tail ht]

