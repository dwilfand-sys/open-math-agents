theorem OMA.solution : OMA.R_Selfridge_selfridge_seq_conjecture_R1.H1 := by
  change 8 ≤ (Nat.fermatNumber 12).primeFactors.card
  rw [factors]
  refine grow (a := 114689) (k := 7) (by decide +kernel) (by decide +kernel) (by decide +kernel) ?_
  refine grow (a := 26017793) (k := 6) (by decide +kernel) (by decide +kernel) (by decide +kernel) ?_
  refine grow (a := 63766529) (k := 5) (by decide +kernel) (by decide +kernel) (by decide +kernel) ?_
  refine grow (a := 190274191361) (k := 4) (by decide +kernel) (by decide +kernel) (by decide +kernel) ?_
  refine grow (a := 1256132134125569) (k := 3) (by decide +kernel) (by decide +kernel) (by decide +kernel) ?_
  refine grow (a := 568630647535356955169033410940867804839360742060818433) (k := 2) (by decide +kernel) (by decide +kernel) (by decide +kernel) ?_
  exact countCofactor
