/-!
Eight distinct prime factors of the twelfth Fermat number.

The six displayed divisors are recorded in the Fermat factor tables linked
by OEIS A046052. @Optymyzt identified the base-3 witness and checked the
integer-root approach independently of Lean in the parent reduction, #8680.
This proof certifies those arithmetic facts and counts the prime supports.
-/

namespace FermatTwelve

private def cofactor : ℕ :=
  

private theorem factors : Nat.fermatNumber 12 = 114689 * (26017793 * (63766529 * (190274191361 * (1256132134125569 * (568630647535356955169033410940867804839360742060818433 * (cofactor)))))) := by
  decide +kernel

-- The characteristic reduction uses repeated squaring at each bit of the exponent.
set_option maxHeartbeats 10000000 in
private theorem fermatTest : (3 : ZMod cofactor) ^ (cofactor - 1) ≠ 1 := by
  change (3 : ZMod ) ^
     ≠ 1
  reduce_mod_char <;> decide +kernel

private theorem notPrime : ¬ cofactor.Prime := by
  intro h
  letI : Fact cofactor.Prime := ⟨h⟩
  exact fermatTest (ZMod.pow_card_sub_one_eq_one (a := (3 : ZMod cofactor)) (by decide +kernel))

