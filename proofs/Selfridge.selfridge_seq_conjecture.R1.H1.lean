private theorem brackets : ∀ k : Fin 500, 2 ≤ k.val →
    (floorRoots[k.val]!) ^ k.val < cofactor ∧
    cofactor < (floorRoots[k.val]! + 1) ^ k.val := by
  decide +kernel

private theorem noSmall : ∀ d : Fin 256, 2 ≤ d.val → ¬ d.val ∣ cofactor := by
  decide +kernel

private theorem notPrimePow : ¬ IsPrimePow cofactor := by
  intro h
  obtain ⟨p, k, hp, hk, hpow⟩ := (isPrimePow_nat_iff _).mp h
  have hd : p ∣ cofactor := by rw [← hpow]; exact dvd_pow_self p hk.ne'
  have hbase : 256 ≤ p := by
    by_contra! hlt
    exact noSmall ⟨p, hlt⟩ hp.two_le hd
  have htop : cofactor < 256 ^ 500 := by decide +kernel
  have hke : k < 500 := by
    by_contra! hbig
    have hg := (Nat.pow_le_pow_left hbase 500).trans (Nat.pow_le_pow_right hp.pos hbig)
    rw [hpow] at hg
    exact htop.not_ge hg
  have htwo : 2 ≤ k := by
    by_contra! hsmall
    have he : k = 1 := by omega
    rw [he, pow_one] at hpow
    exact notPrime (hpow ▸ hp)
  let j : Fin 500 := ⟨k, hke⟩
  obtain ⟨hlo, hhi⟩ := brackets j htwo
  by_cases hle : p ≤ floorRoots[k]!
  · have h := Nat.pow_le_pow_left hle k
    exact hlo.not_ge (hpow ▸ h)
  · have h := Nat.pow_le_pow_left (show floorRoots[k]! + 1 ≤ p by omega) k
    exact hhi.not_ge (hpow ▸ h)

private theorem countCofactor : 2 ≤ cofactor.primeFactors.card :=
  Finset.one_lt_card_iff_nontrivial.mpr
    ((Nat.not_isPrimePow_iff_nontrivial_of_two_le (by decide +kernel : 2 ≤ cofactor)).mp notPrimePow)

private theorem grow {a b k : ℕ} (ha : 2 ≤ a) (hb : 2 ≤ b)
    (hc : a.Coprime b) (hk : k ≤ b.primeFactors.card) :
    k + 1 ≤ (a * b).primeFactors.card := by
  have hm : a.minFac ∈ a.primeFactors :=
    Nat.mem_primeFactors.mpr ⟨Nat.minFac_prime (by omega), Nat.minFac_dvd _, by omega⟩
  have hpos := Finset.card_pos.mpr ⟨_, hm⟩
  rw [Nat.primeFactors_mul (show a ≠ 0 by omega) (show b ≠ 0 by omega),
    Finset.card_union_of_disjoint hc.disjoint_primeFactors]
  omega

