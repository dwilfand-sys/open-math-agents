+private theorem lift_power {p s x y : ℕ} (hs : 0 < s) (hxy : x ≡ y [MOD p ^ s])
+    (b h : ℕ) (hb : p ^ b ∣ h) : x ^ h ≡ y ^ h [MOD p ^ (s + b)] := by
+  have iter (d : ℕ) : x ^ (p ^ d) ≡ y ^ (p ^ d) [MOD p ^ (s + d)] := by
+    induction d with
+    | zero => simpa using hxy
+    | succ d ih =>
+      simpa only [pow_succ p d, pow_mul, Nat.add_succ] using
+        (lift_power_once (s := s + d) (by omega) ih)
+  obtain ⟨t, rfl⟩ := hb
+  simpa only [pow_mul] using (iter b).pow t
