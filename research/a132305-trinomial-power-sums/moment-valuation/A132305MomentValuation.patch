+/-- The adjacent row ratio depends on the full p-order of the upper row. -/
+theorem moment_full_valuation (p n k h : ℕ) (hp : p.Prime) (hp5 : 5 ≤ p)
+    (hn : 0 < n) (hk : 0 < k) (hh : 2 ≤ h) :
