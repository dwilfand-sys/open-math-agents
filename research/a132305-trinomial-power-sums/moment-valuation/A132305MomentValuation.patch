+private theorem lift_power_once {p s x y : ℕ} (hs : 0 < s)
+    (h : x ≡ y [MOD p ^ s]) : x ^ p ≡ y ^ p [MOD p ^ (s + 1)] := by
+  have d : (p : ℤ) ^ s ∣ (y : ℤ) - (x : ℤ) := by
+    simpa only [Nat.cast_pow] using Nat.modEq_iff_dvd.mp h
+  have dp : (p : ℤ) ∣ (y : ℤ) - (x : ℤ) :=
+    (dvd_pow_self _ (by omega : s ≠ 0)).trans d
+  have multiple := mul_dvd_mul (dvd_geom_sum₂_self (n := p) dp) d
+  rw [geom_sum₂_mul] at multiple
+  apply Nat.modEq_iff_dvd.mpr
+  simpa only [Nat.cast_pow, pow_succ', Nat.cast_mul] using multiple
