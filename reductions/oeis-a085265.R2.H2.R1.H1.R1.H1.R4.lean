import OMAReductions.R_oeis_a085265_R2_H2_R1_H1_R1
import Mathlib

/-!
# A085265 finite prime counts in the dyadic sieve

Credit: @dwilfand-sys. The original statement was formalized by @niclorusso.
The numerical budget on each interval uses the odd-prime count at a small
endpoint together with a bound on its subsequent increments. The second
hypothesis isolates those increments by subtracting the actual endpoint count
and testing the known numerical allowance in its place. The table contains
the endpoints for both the one- and two-representation sieves.
-/

open scoped BigOperators

namespace OMA.R_oeis_a085265_R2_H2_R1_H1_R1_H1_R4

def H1 : Prop :=
  let packed : ℕ := 
  let seeds : List (ℕ × ℕ) := (List.range 242).scanl (fun q i =>
    let z := (packed >>> (17*i)) % 131072
    (q.1 + z%1024, q.2 + z/1024)) (0,0)
  ∀ c ∈ seeds, ((Finset.range (c.1+1)).filter (fun p => 2 < p ∧ Nat.Prime p)).card ≤ c.2

def H2 : Prop :=
  let packed : ℕ := 
  let seeds : List (ℕ × ℕ) := (List.range 242).scanl (fun q i =>
    let z := (packed >>> (17*i)) % 131072
    (q.1 + z%1024, q.2 + z/1024)) (0,0)
  ∀ (J : ℕ) (S : Finset ℕ), 300 ≤ J → J ≤ 1000000 →
    (∀ p ∈ S, 2 < p ∧ p.Prime) → (∏ p ∈ S, p) ≤ 2*J+2 →
    ∃ c ∈ seeds,
      ((∑ p ∈ ((Finset.range (2*J+1+1)).filter (fun p => 2 < p ∧ Nat.Prime p)) \ S,
        (2*J/(p^2)+1) : ℕ) : ℚ) + (if S.card=0 then 0 else (2:ℚ)^(S.card-1)) - (((Finset.range (c.1+1)).filter (fun p => 2 < p ∧ Nat.Prime p)).card : ℚ) + (c.2 : ℚ) < (J:ℚ) * ∏ p ∈ S, (1-1/(p:ℚ))

set_option maxRecDepth 10000 in
theorem main : H1 → H2 → OMA.R_oeis_a085265_R2_H2_R1_H1_R1.H1 := by
  intro hcounts hincrement J S hlo hhi hS hprod
  obtain ⟨c,hc,hm⟩ := hincrement J S hlo hhi hS hprod
  have hq : (((Finset.range (c.1+1)).filter (fun p => 2 < p ∧ Nat.Prime p)).card : ℚ) ≤ (c.2 : ℚ) := by
    exact_mod_cast hcounts c hc
  linarith only [hq, hm]

end OMA.R_oeis_a085265_R2_H2_R1_H1_R1_H1_R4
