import Mathlib

/-!
The inclusive odd-prime cost has one uniform analytical upper bound.
The upper bound can be certified separately at the 79 endpoints.
Source: https://oeis.org/A085265
Credit: @dwilfand-sys
-/
open scoped BigOperators

namespace OMA.R_oeis_a085265_R2_H2_R1_H1_R1_H1_R1_H1_R1

def H1 : Prop :=
  let survivors : ℕ → ℤ := ([101,97,89,83,79,73,71,67,61,59,53,47,43,41,37,31,29,23,19,17,13,11,7,5,3,2] : List ℕ).foldr
    (fun p g y => g y - g (y / p)) (fun y => (y : ℤ))
  ∀ j : ℕ, 300 ≤ j → j ≤ 1000000 →
  (((∑ p ∈ (Finset.range (2*j+2)).filter (fun p => 2 < p ∧ Nat.Prime p),
    (2*j/(p^2)+1)) : ℕ) : ℤ) ≤ survivors (2*j+1) + 24 +
    ((∑ p ∈ (Finset.range 1415).filter (fun p => 2 < p ∧ Nat.Prime p), 2*j/(p^2) : ℕ) : ℤ)

